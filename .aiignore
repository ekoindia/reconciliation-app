# .aiignore — exclude sensitive and irrelevant paths from AI tools / training context.
# Mirrors the sensitive entries in .gitignore. Keep in sync with it.

# === Secrets / env ===
.env
.env.*
!.env.example
*.key
*.pem
*.cnf

# === Real data / recon artifacts (never expose) ===
*.db
*.sqlite
uploads/
output/
temp/
*.log

# === Deployment-specific instance data (real account numbers) ===
backend/instance/*
!backend/instance/*.example.json

# === Internal documents ===
*.docx
*.xlsx
*.xls
*.pdf

# === Dependencies / build artifacts (noise) ===
node_modules/
dist/
build/
__pycache__/
*.py[cod]
venv/
.venv/
