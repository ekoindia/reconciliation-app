# Normalize line endings: LF in the repo, native on checkout where it matters
* text=auto

*.py text
*.js text
*.jsx text
*.css text
*.html text
*.md text
*.json text
*.yml text
*.yaml text
*.sh text eol=lf
*.bat text eol=crlf

# Binary
*.png binary
*.jpg binary
*.ico binary
*.db binary
*.sqlite binary
*.xlsx binary
*.xls binary
*.docx binary
*.pdf binary
